# ===== LLM 配置（任一 OpenAI 兼容接口均可）=====
# 留空 LLM_API_KEY 即进入 Mock 模式：无需 Key，用确定性规则跑通全流程
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# 智谱 GLM 示例：
#   LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#   LLM_MODEL=glm-4-flash
# DeepSeek 示例：
#   LLM_BASE_URL=https://api.deepseek.com/v1
#   LLM_MODEL=deepseek-chat

LLM_TEMPERATURE=0.6

# ===== 面试节奏 =====
MAX_FOLLOWUP_DEPTH=3
MAX_PROBE_WEAKNESSES=3
MAX_DRILL_ROUNDS=4
MAX_STRESS_ROUNDS=2

# CORS（前端开发服务器默认不需要改）
CORS_ORIGINS=*
