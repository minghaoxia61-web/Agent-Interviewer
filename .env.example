# ===== LLM 配置（任一 OpenAI 兼容接口均可）=====
# 留空 LLM_API_KEY 即进入 Mock 模式：无需 Key，用确定性规则跑通全流程
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# 智谱 GLM 示例：
#   LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#   LLM_MODEL=glm-4-flash
# DeepSeek 示例：
#   LLM_BASE_URL=https://api.deepseek.com/v1
#   LLM_MODEL=deepseek-chat

LLM_TEMPERATURE=0.6

# ===== 面试节奏 =====
MAX_FOLLOWUP_DEPTH=3
MAX_PROBE_WEAKNESSES=3
MAX_DRILL_ROUNDS=4
MAX_STRESS_ROUNDS=2

# CORS（前端开发服务器默认不需要改）
CORS_ORIGINS=*

# ===== 公网部署护栏（部署到 Railway/云服务器时务必设置）=====
# 非空时所有 API/WS 需携带 X-API-Token 头（或 ?token= 参数），前端会弹出令牌输入框
ACCESS_TOKEN=
RATE_LIMIT_DAILY=300

# ===== 检索引擎 =====
# auto（默认，优先 Chroma，失败/超时回落 BM25）/ bm25 / ngram / chroma
# chroma 需先 pip install -r requirements-rag.txt；内置 embedding 模型首次使用需联网
RETRIEVER_MODE=auto
